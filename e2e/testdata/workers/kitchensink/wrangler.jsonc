{
  "name": "kitchensink",
  "main": "./build/worker.mjs",
  "compatibility_date": "2025-06-01",
  "vars": {
    "GREETING": "hello"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "kitchensink-kv"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "kitchensink-r2"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kitchensink",
      "database_id": "kitchensink-db"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "QUEUE",
        "queue": "kitchensink-queue"
      }
    ],
    "consumers": [
      {
        "queue": "kitchensink-queue",
        "max_batch_size": 1,
        "max_batch_timeout": 1
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 2,
        "period": 10
      }
    }
  ],
  // Analytics Engine is simulated locally. writeDataPoint succeeds and the
  // point is discarded; this runtime has no read API for those points.
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "kitchensink"
    }
  ],
  // Images is simulated inside workerd. Workers AI is not: that binding
  // always opens a remote proxy and is configured in wrangler.ai.jsonc so
  // a missing account does not stop this dev session.
  "images": {
    "binding": "IMAGES"
  }
}
